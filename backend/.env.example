# Copy this file to backend/.env and replace the placeholders.
# Do not commit backend/.env.

DB_USER=your_postgres_user
DB_HOST=localhost
DB_NAME=docutrack
DB_PORT=5432

# Optional. Leave unset when PostgreSQL accepts the local user without a password.
# DB_PASSWORD=your_database_password

# Use a long random string. Do not reuse an example value.
JWT_SECRET=replace-with-a-long-random-string

# Optional. The API listens on this port. The default is 5001.
BACKEND_PORT=5001
